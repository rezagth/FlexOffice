generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------
// `Profile.id` is NOT generated by Prisma: it equals the id of the matching
// row in Supabase's `auth.users` table. Rows are created by the
// `handle_new_user` Postgres trigger (see migration 0002), never by the app
// inserting directly — this keeps "auth user exists" and "profile exists"
// atomic. The real foreign key to `auth.users(id)` is also added by hand in
// that migration, since Prisma does not manage the `auth` schema.
/// DEPRECATED — Phase 2 replaced this with three independent facts:
/// `Profile.platformRole` (USER | ADMIN), `Profile.isLandlord` (a capability)
/// and `Profile.activeMode` (TENANT | LANDLORD). The enum conflated who you
/// are to the platform with what you are doing, which is why one person could
/// not be both a renter and a lister.
///
/// Still written by the signup trigger and still present on the column so the
/// migration stays reversible. Nothing reads it for authorization. Removing
/// it is a separate migration — see the Phase 2 report.
enum Role {
  CLIENT
  PARTNER
  ADMIN
}

/// Who the account is to the platform. Independent of what they are doing:
/// an administrator is also an ordinary user who can rent and let spaces.
enum PlatformRole {
  USER
  ADMIN
}

/// What the account is currently doing. A context, never a permission —
/// LANDLORD mode grants nothing that the organization membership does not
/// already carry.
enum ActiveMode {
  TENANT
  LANDLORD
}

model Profile {
  id             String        @id @db.Uuid
  email          String        @unique
  name           String
  phone          String?
  /// @deprecated see the `Role` enum. Kept for reversibility only.
  role           Role
  /// @deprecated superseded by `OrganizationMember`. A profile can now belong
  /// to several organizations, so a single column cannot express membership.
  /// Kept for reversibility only; `activeOrganizationId` is the current
  /// selection and the membership table is the authority.
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  platformRole         PlatformRole  @default(USER) @map("platform_role")
  /// The landlord capability has been unlocked ("Devenir bailleur"). A
  /// capability, NOT an authorization: every landlord action is still checked
  /// against an ACTIVE OrganizationMember row and the resolved capability set.
  isLandlord           Boolean       @default(false) @map("is_landlord")
  /// Stored server-side rather than in a cookie: a column cannot be forged at
  /// all, and getAuthContext() already loads the profile. A DB CHECK also
  /// makes LANDLORD-without-capability unrepresentable.
  activeMode           ActiveMode    @default(TENANT) @map("active_mode")
  /// Last selected organization. A convenience, never a grant — always
  /// revalidated against an ACTIVE membership before use, because a stored id
  /// goes stale when a membership is revoked.
  activeOrganizationId String?       @map("active_organization_id") @db.Uuid
  activeOrganization   Organization? @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id])

  // Set on GDPR account deletion for a profile that has bookings (and
  // therefore cannot be hard-deleted, see bookings_client_user_id_fkey
  // ON DELETE RESTRICT). name/email/phone are anonymized at the same time.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships    OrganizationMember[] @relation("MemberProfile")
  invitedMembers OrganizationMember[] @relation("MemberInvitedBy")
  bookings       Booking[]
  favorites      Favorite[]
  disputesRaised Dispute[]            @relation("DisputeRaisedBy")
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@index([activeOrganizationId])
  @@map("profiles")
}

/// Who holds the letting activity. An INDIVIDUAL's identity already lives on
/// the Profile, so the organization carries only the activity; a COMPANY
/// carries its own registration details.
enum HolderType {
  INDIVIDUAL
  COMPANY
}

/// Role inside one organization. Five values now, granular permissions later:
/// call sites resolve capabilities through
/// `src/server/auth/capabilities.ts` rather than comparing this value, so
/// replacing the enum with a role/permission table stays a local change.
enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

/// The link that replaces `Profile.organizationId`, and the authority for
/// every landlord authorization decision.
///
/// One membership per (organization, person) — enforced by the composite
/// primary key, so a duplicate is impossible rather than merely unlikely.
///
/// NOT enforced in the database: "an organization always has at least one
/// ACTIVE OWNER". A CHECK cannot see other rows, and multiple OWNERs must
/// stay legal (an agency with two partners is the normal case), so a unique
/// index would be wrong. Enforced in
/// `src/server/domains/organizations/membership.ts`, with a test.
model OrganizationMember {
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profileId      String       @map("profile_id") @db.Uuid
  profile        Profile      @relation("MemberProfile", fields: [profileId], references: [id], onDelete: Cascade)

  orgRole OrgRole          @map("org_role")
  status  MembershipStatus @default(ACTIVE)

  joinedAt           DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  invitedByProfileId String?  @map("invited_by_profile_id") @db.Uuid
  invitedBy          Profile? @relation("MemberInvitedBy", fields: [invitedByProfileId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organizationId, profileId])
  @@index([profileId])
  @@index([organizationId, status])
  @@map("organization_members")
}

// ---------------------------------------------------------------------------
// Organizations & Spaces
// ---------------------------------------------------------------------------
enum OrganizationStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

model Organization {
  id                      String             @id @default(uuid()) @db.Uuid
  name                    String
  /// INDIVIDUAL or COMPANY. Drives which registration fields apply and
  /// whether a SIRET is required — see the CHECK constraints in migration
  /// 20260904100000_account_model_expand.
  holderType              HolderType         @default(COMPANY) @map("holder_type")
  /// Nullable since Phase 2: an individual holder has no SIRET. Still unique
  /// where present — PostgreSQL treats NULLs as distinct, so any number of
  /// individuals coexist while two companies cannot share a SIRET.
  siret                   String?            @unique
  /// Registration details, COMPANY only. Collected progressively: the
  /// verification of these values (Kbis, VAT lookup) is Phase 3.
  legalName               String?            @map("legal_name")
  siren                   String?
  vatNumber               String?            @map("vat_number")
  legalRepresentativeName String?            @map("legal_representative_name")
  status                  OrganizationStatus @default(PENDING_VERIFICATION)
  email                   String
  address                 String
  city                    String
  postalCode              String             @map("postal_code")
  // Stripe Connect account id (Express/Standard). Null until the
  // organization completes onboarding — payouts stay on the mock provider
  // until this is set and PAYMENT_PROVIDER=stripe.
  stripeAccountId         String?            @map("stripe_account_id")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// @deprecated the reverse side of `Profile.organizationId`. Use
  /// `memberships` — it is the authority for who belongs to an organization.
  members           Profile[]
  activeForProfiles Profile[]            @relation("ActiveOrganization")
  memberships       OrganizationMember[]
  spaces            Space[]
  bookings          Booking[]
  payments          Payment[]
  auditLogs         AuditLog[]

  @@index([status])
  @@map("organizations")
}

enum SpaceType {
  MEETING_ROOM
  DESK
  TRAINING_ROOM
}

enum SpaceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Space {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id])
  slug               String       @unique
  name               String
  type               SpaceType
  description        String
  address            String
  city               String
  postalCode         String       @map("postal_code")
  capacity           Int
  amenities          String[]
  photos             String[]
  halfDayPriceCents  Int          @map("half_day_price_cents")
  dayPriceCents      Int          @map("day_price_cents")
  // Shown to the client only after a booking is confirmed (door code,
  // reception instructions, floor). Optional: partners may not need one.
  accessInstructions String?      @map("access_instructions")
  // IANA zone the opening hours are expressed in — see domains/bookings/timezone.ts.
  timezone           String       @default("Europe/Paris")
  status             SpaceStatus  @default(DRAFT)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  openingHours SpaceOpeningHours[]
  closures     SpaceClosure[]
  bookings     Booking[]
  favorites    Favorite[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([city, status])
  @@map("spaces")
}

model SpaceOpeningHours {
  id       String @id @default(uuid()) @db.Uuid
  spaceId  String @map("space_id") @db.Uuid
  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  weekday  Int // 0 = Sunday .. 6 = Saturday
  opensAt  String @map("opens_at") // "09:00"
  closesAt String @map("closes_at") // "19:00"

  @@unique([spaceId, weekday])
  @@map("space_opening_hours")
}

model SpaceClosure {
  id       String   @id @default(uuid()) @db.Uuid
  spaceId  String   @map("space_id") @db.Uuid
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  reason   String

  @@index([spaceId])
  @@map("space_closures")
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  COMPLETED
}

// NOTE: double-booking is prevented at the database level by a PostgreSQL
// EXCLUDE constraint on (space_id, tsrange(starts_at, ends_at)) for rows
// where status is PENDING or CONFIRMED. Added by hand in migration 0003
// (Prisma cannot express EXCLUDE constraints) — see prisma/migrations.
model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  spaceId               String        @map("space_id") @db.Uuid
  space                 Space         @relation(fields: [spaceId], references: [id])
  organizationId        String        @map("organization_id") @db.Uuid
  organization          Organization  @relation(fields: [organizationId], references: [id])
  clientUserId          String        @map("client_user_id") @db.Uuid
  clientUser            Profile       @relation(fields: [clientUserId], references: [id])
  startsAt              DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime      @map("ends_at") @db.Timestamptz(3)
  status                BookingStatus @default(PENDING)
  participantsCount     Int           @map("participants_count")
  purpose               String
  priceAmountCents      Int           @map("price_amount_cents")
  commissionAmountCents Int           @map("commission_amount_cents")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment  Payment?
  disputes Dispute[]

  // Referenced side of the composite foreign keys that keep the
  // denormalised organizationId in step with the space's and the
  // payment's — see migration 20260903110100_business_integrity_constraints.
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([spaceId, startsAt])
  @@index([clientUserId])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------
enum PaymentStatus {
  REQUIRES_CAPTURE
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  bookingId               String        @unique @map("booking_id") @db.Uuid
  booking                 Booking       @relation(fields: [bookingId], references: [id])
  organizationId          String        @map("organization_id") @db.Uuid
  organization            Organization  @relation(fields: [organizationId], references: [id])
  provider                String        @default("mock")
  providerPaymentIntentId String        @unique @map("provider_payment_intent_id")
  amountCents             Int           @map("amount_cents")
  commissionAmountCents   Int           @map("commission_amount_cents")
  netAmountCents          Int           @map("net_amount_cents")
  status                  PaymentStatus @default(REQUIRES_CAPTURE)
  capturedAt              DateTime?     @map("captured_at") @db.Timestamptz(3)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  refunds Refund[]

  @@index([organizationId, status])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  payment          Payment      @relation(fields: [paymentId], references: [id])
  amountCents      Int          @map("amount_cents")
  reason           String
  providerRefundId String       @unique @map("provider_refund_id")
  status           RefundStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([paymentId])
  @@map("refunds")
}

// Idempotency ledger for provider webhooks (Stripe today, others later).
model WebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String   @unique @map("provider_event_id")
  type            String
  payload         Json
  processedAt     DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@index([provider, type])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------
enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED_REFUND
  RESOLVED_NO_ACTION
  ESCALATED
}

model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  booking         Booking       @relation(fields: [bookingId], references: [id])
  raisedByUserId  String        @map("raised_by_user_id") @db.Uuid
  raisedBy        Profile       @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id])
  status          DisputeStatus @default(OPEN)
  description     String
  resolutionNotes String?       @map("resolution_notes")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  events DisputeEvent[]

  @@index([bookingId])
  @@index([status])
  @@map("disputes")
}

// Append-only trail of status changes, for the traced/timestamped process
// required by the brief (signalement -> enquête -> résolution).
model DisputeEvent {
  id        String        @id @default(uuid()) @db.Uuid
  disputeId String        @map("dispute_id") @db.Uuid
  dispute   Dispute       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  status    DisputeStatus
  note      String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([disputeId])
  @@map("dispute_events")
}

// ---------------------------------------------------------------------------
// Misc
// ---------------------------------------------------------------------------
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  user      Profile  @relation(fields: [userId], references: [id])
  spaceId   String   @map("space_id") @db.Uuid
  space     Space    @relation(fields: [spaceId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, spaceId])
  @@map("favorites")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  actor          Profile?      @relation(fields: [actorUserId], references: [id])
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  event          String
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([event])
  @@map("audit_logs")
}
