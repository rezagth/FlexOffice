generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------
// `Profile.id` is NOT generated by Prisma: it equals the id of the matching
// row in Supabase's `auth.users` table. Rows are created by the
// `handle_new_user` Postgres trigger (see migration 0002), never by the app
// inserting directly — this keeps "auth user exists" and "profile exists"
// atomic. The real foreign key to `auth.users(id)` is also added by hand in
// that migration, since Prisma does not manage the `auth` schema.
enum Role {
  CLIENT
  PARTNER
  ADMIN
}

model Profile {
  id             String        @id @db.Uuid
  email          String        @unique
  name           String
  phone          String?
  role           Role
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  bookings       Booking[]
  favorites      Favorite[]
  disputesRaised Dispute[]  @relation("DisputeRaisedBy")
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Organizations & Spaces
// ---------------------------------------------------------------------------
enum OrganizationStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

model Organization {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  siret      String             @unique
  status     OrganizationStatus @default(PENDING_VERIFICATION)
  email      String
  address    String
  city       String
  postalCode String             @map("postal_code")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  members   Profile[]
  spaces    Space[]
  bookings  Booking[]
  payments  Payment[]
  auditLogs AuditLog[]

  @@index([status])
  @@map("organizations")
}

enum SpaceType {
  MEETING_ROOM
  DESK
  TRAINING_ROOM
}

enum SpaceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Space {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id])
  slug              String       @unique
  name              String
  type              SpaceType
  description       String
  address           String
  city              String
  postalCode        String       @map("postal_code")
  capacity          Int
  amenities         String[]
  photos            String[]
  halfDayPriceCents Int          @map("half_day_price_cents")
  dayPriceCents     Int          @map("day_price_cents")
  status            SpaceStatus  @default(DRAFT)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  openingHours SpaceOpeningHours[]
  closures     SpaceClosure[]
  bookings     Booking[]
  favorites    Favorite[]

  @@index([organizationId])
  @@index([city, status])
  @@map("spaces")
}

model SpaceOpeningHours {
  id       String @id @default(uuid()) @db.Uuid
  spaceId  String @map("space_id") @db.Uuid
  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  weekday  Int // 0 = Sunday .. 6 = Saturday
  opensAt  String @map("opens_at") // "09:00"
  closesAt String @map("closes_at") // "19:00"

  @@unique([spaceId, weekday])
  @@map("space_opening_hours")
}

model SpaceClosure {
  id       String   @id @default(uuid()) @db.Uuid
  spaceId  String   @map("space_id") @db.Uuid
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")
  reason   String

  @@index([spaceId])
  @@map("space_closures")
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  COMPLETED
}

// NOTE: double-booking is prevented at the database level by a PostgreSQL
// EXCLUDE constraint on (space_id, tsrange(starts_at, ends_at)) for rows
// where status is PENDING or CONFIRMED. Added by hand in migration 0003
// (Prisma cannot express EXCLUDE constraints) — see prisma/migrations.
model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  spaceId               String        @map("space_id") @db.Uuid
  space                 Space         @relation(fields: [spaceId], references: [id])
  organizationId        String        @map("organization_id") @db.Uuid
  organization          Organization  @relation(fields: [organizationId], references: [id])
  clientUserId          String        @map("client_user_id") @db.Uuid
  clientUser            Profile       @relation(fields: [clientUserId], references: [id])
  startsAt              DateTime      @map("starts_at")
  endsAt                DateTime      @map("ends_at")
  status                BookingStatus @default(PENDING)
  participantsCount     Int           @map("participants_count")
  purpose               String
  priceAmountCents      Int           @map("price_amount_cents")
  commissionAmountCents Int           @map("commission_amount_cents")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  payment  Payment?
  disputes Dispute[]

  @@index([organizationId, status])
  @@index([spaceId, startsAt])
  @@index([clientUserId])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------
enum PaymentStatus {
  REQUIRES_CAPTURE
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  bookingId               String        @unique @map("booking_id") @db.Uuid
  booking                 Booking       @relation(fields: [bookingId], references: [id])
  organizationId          String        @map("organization_id") @db.Uuid
  organization            Organization  @relation(fields: [organizationId], references: [id])
  provider                String        @default("mock")
  providerPaymentIntentId String        @unique @map("provider_payment_intent_id")
  amountCents             Int           @map("amount_cents")
  commissionAmountCents   Int           @map("commission_amount_cents")
  netAmountCents          Int           @map("net_amount_cents")
  status                  PaymentStatus @default(REQUIRES_CAPTURE)
  capturedAt              DateTime?     @map("captured_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  refunds Refund[]

  @@index([organizationId, status])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  payment          Payment      @relation(fields: [paymentId], references: [id])
  amountCents      Int          @map("amount_cents")
  reason           String
  providerRefundId String       @unique @map("provider_refund_id")
  status           RefundStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([paymentId])
  @@map("refunds")
}

// Idempotency ledger for provider webhooks (Stripe today, others later).
model WebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String   @unique @map("provider_event_id")
  type            String
  payload         Json
  processedAt     DateTime @default(now()) @map("processed_at")

  @@index([provider, type])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------
enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED_REFUND
  RESOLVED_NO_ACTION
  ESCALATED
}

model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  booking         Booking       @relation(fields: [bookingId], references: [id])
  raisedByUserId  String        @map("raised_by_user_id") @db.Uuid
  raisedBy        Profile       @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id])
  status          DisputeStatus @default(OPEN)
  description     String
  resolutionNotes String?       @map("resolution_notes")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  events DisputeEvent[]

  @@index([bookingId])
  @@index([status])
  @@map("disputes")
}

// Append-only trail of status changes, for the traced/timestamped process
// required by the brief (signalement -> enquête -> résolution).
model DisputeEvent {
  id        String        @id @default(uuid()) @db.Uuid
  disputeId String        @map("dispute_id") @db.Uuid
  dispute   Dispute       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  status    DisputeStatus
  note      String?
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([disputeId])
  @@map("dispute_events")
}

// ---------------------------------------------------------------------------
// Misc
// ---------------------------------------------------------------------------
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  user      Profile  @relation(fields: [userId], references: [id])
  spaceId   String   @map("space_id") @db.Uuid
  space     Space    @relation(fields: [spaceId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, spaceId])
  @@map("favorites")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  actor          Profile?      @relation(fields: [actorUserId], references: [id])
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  event          String
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([event])
  @@map("audit_logs")
}
