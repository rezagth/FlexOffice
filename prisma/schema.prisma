generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------
// `Profile.id` is NOT generated by Prisma: it equals the id of the matching
// row in Supabase's `auth.users` table. Rows are created by the
// `handle_new_user` Postgres trigger (see migration 0002), never by the app
// inserting directly — this keeps "auth user exists" and "profile exists"
// atomic. The real foreign key to `auth.users(id)` is also added by hand in
// that migration, since Prisma does not manage the `auth` schema.
/// DEPRECATED — Phase 2 replaced this with three independent facts:
/// `Profile.platformRole` (USER | ADMIN), `Profile.isLandlord` (a capability)
/// and `Profile.activeMode` (TENANT | LANDLORD). The enum conflated who you
/// are to the platform with what you are doing, which is why one person could
/// not be both a renter and a lister.
///
/// Still written by the signup trigger and still present on the column so the
/// migration stays reversible. Nothing reads it for authorization. Removing
/// it is a separate migration — see the Phase 2 report.
enum Role {
  CLIENT
  PARTNER
  ADMIN
}

/// Who the account is to the platform. Independent of what they are doing:
/// an administrator is also an ordinary user who can rent and let spaces.
enum PlatformRole {
  USER
  ADMIN
}

/// What the account is currently doing. A context, never a permission —
/// LANDLORD mode grants nothing that the organization membership does not
/// already carry.
enum ActiveMode {
  TENANT
  LANDLORD
}

model Profile {
  id             String        @id @db.Uuid
  email          String        @unique
  name           String
  phone          String?
  /// @deprecated see the `Role` enum. Kept for reversibility only.
  role           Role
  /// @deprecated superseded by `OrganizationMember`. A profile can now belong
  /// to several organizations, so a single column cannot express membership.
  /// Kept for reversibility only; `activeOrganizationId` is the current
  /// selection and the membership table is the authority.
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  platformRole         PlatformRole  @default(USER) @map("platform_role")
  /// The landlord capability has been unlocked ("Devenir bailleur"). A
  /// capability, NOT an authorization: every landlord action is still checked
  /// against an ACTIVE OrganizationMember row and the resolved capability set.
  isLandlord           Boolean       @default(false) @map("is_landlord")
  /// Stored server-side rather than in a cookie: a column cannot be forged at
  /// all, and getAuthContext() already loads the profile. A DB CHECK also
  /// makes LANDLORD-without-capability unrepresentable.
  activeMode           ActiveMode    @default(TENANT) @map("active_mode")
  /// Last selected organization. A convenience, never a grant — always
  /// revalidated against an ACTIVE membership before use, because a stored id
  /// goes stale when a membership is revoked.
  activeOrganizationId String?       @map("active_organization_id") @db.Uuid
  activeOrganization   Organization? @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id])

  // Set on GDPR account deletion for a profile that has bookings (and
  // therefore cannot be hard-deleted, see bookings_client_user_id_fkey
  // ON DELETE RESTRICT). name/email/phone are anonymized at the same time.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships    OrganizationMember[] @relation("MemberProfile")
  invitedMembers OrganizationMember[] @relation("MemberInvitedBy")
  bookings       Booking[]
  favorites      Favorite[]
  disputesRaised Dispute[]            @relation("DisputeRaisedBy")
  auditLogs      AuditLog[]

  verificationsRequested        LandlordVerification[] @relation("VerificationRequestedBy")
  verificationsReviewed         LandlordVerification[] @relation("VerificationReviewedBy")
  verificationDocumentsUploaded VerificationDocument[] @relation("VerificationDocumentUploadedBy")

  propertiesCreated  Property[]         @relation("PropertyCreatedBy")
  propertyOwnerOf    PropertyOwner[]    @relation("PropertyOwnerProfile")
  propertyOperatorOf PropertyOperator[] @relation("PropertyOperatorProfile")
  propertyManagerOf  PropertyManager[]  @relation("PropertyManagerProfile")

  messagesSent   Message[]
  supportTickets SupportTicket[]

  @@index([organizationId])
  @@index([activeOrganizationId])
  @@map("profiles")
}

/// One side of "why may this organization let a space" — see
/// `LandlordActivityType` below for the distinction from `OrgRole.OWNER`.
enum LandlordActivityType {
  OWNER
  OPERATOR
}

enum VerificationStatus {
  DRAFT
  PENDING_REVIEW
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

/// The dossier behind "Devenir bailleur": why an organization may let a
/// space, and OfficeFlex's review of the evidence for it. Scoped to the
/// organization's activity as a whole — Phase 4's Property/PropertyOwner/
/// PropertyOperator models attach this to individual properties.
///
/// `activityType` is a different axis from `OrgRole.OWNER`
/// (Phase 2, membership inside an organization): this answers "does the
/// organization own the space or merely exploit it under a sublet
/// authorisation", not "what may this person do inside the organization".
model LandlordVerification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  requestedByProfileId String  @map("requested_by_profile_id") @db.Uuid
  requestedBy          Profile @relation("VerificationRequestedBy", fields: [requestedByProfileId], references: [id])

  activityType LandlordActivityType @map("activity_type")
  status       VerificationStatus   @default(DRAFT)
  /// Only meaningful when the organization's holderType is COMPANY — an
  /// individual cannot hold a French real-estate professional card. Not
  /// cross-checked by a CHECK constraint, same reasoning as the rest of
  /// this dossier (see requirements.ts): the holder/activity combination
  /// already lives in application code, not in SQL.
  isRealEstateProfessional Boolean @default(false) @map("is_real_estate_professional")

  submittedAt         DateTime? @map("submitted_at") @db.Timestamptz(3)
  reviewStartedAt     DateTime? @map("review_started_at") @db.Timestamptz(3)
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(3)
  /// SET NULL, not RESTRICT: the reviewer's own account may later be
  /// deleted or anonymized; the decision itself must survive that.
  reviewedByProfileId String?   @map("reviewed_by_profile_id") @db.Uuid
  reviewedBy          Profile?  @relation("VerificationReviewedBy", fields: [reviewedByProfileId], references: [id])
  /// A rejection without a reason is the failure mode this exists to
  /// prevent — enforced by `landlord_verifications_rejection_reason_check`.
  rejectionReason     String?   @map("rejection_reason")
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  documents VerificationDocument[]

  @@index([organizationId])
  @@index([status])
  @@map("landlord_verifications")
}

/// Kept open-ended on purpose: which types are REQUIRED for a given
/// (holderType, activityType) pair is a business rule in
/// `src/server/domains/verification/requirements.ts`, not a database
/// constraint — adding a new required document later is a code change.
enum VerificationDocumentType {
  IDENTITY_DOCUMENT
  OWNERSHIP_PROOF
  K_BIS
  VAT_PROOF
  LEGAL_REPRESENTATIVE_ID
  SUBLEASE_AUTHORIZATION
  /// Carte professionnelle (carte T), required by French law for a real
  /// estate agency/foncière/conciergerie — only requested when the dossier
  /// is flagged `isRealEstateProfessional` (see requirements.ts).
  PROFESSIONAL_CARD
  OTHER
}

enum VerificationDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Evidence attached to a dossier. Never the file itself — only where it
/// lives in the private `verification-documents` Storage bucket and enough
/// metadata to review and retain it. See
/// `src/server/domains/verification/storage.ts` for why `storagePath` is
/// server-generated and never derived from `originalFilename`.
model VerificationDocument {
  id             String               @id @default(uuid()) @db.Uuid
  verificationId String               @map("verification_id") @db.Uuid
  verification   LandlordVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  type VerificationDocumentType

  /// Internal, server-generated Storage object key.
  storagePath      String                     @unique @map("storage_path")
  /// Sanitized for DISPLAY only — never used to build a storage path or any
  /// other identifier.
  originalFilename String                     @map("original_filename")
  mimeType         String                     @map("mime_type")
  sizeBytes        Int                        @map("size_bytes")
  /// SHA-256 hex of the uploaded bytes, computed server-side.
  checksum         String?
  status           VerificationDocumentStatus @default(PENDING)

  uploadedByProfileId String    @map("uploaded_by_profile_id") @db.Uuid
  uploadedBy          Profile   @relation("VerificationDocumentUploadedBy", fields: [uploadedByProfileId], references: [id])
  uploadedAt          DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  /// RGPD: when set, a retention job (a later phase) purges the object and
  /// this row past this date. Null means "still part of an active dossier".
  retentionUntil      DateTime? @map("retention_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([verificationId])
  @@map("verification_documents")
}

/// Who holds the letting activity. An INDIVIDUAL's identity already lives on
/// the Profile, so the organization carries only the activity; a COMPANY
/// carries its own registration details.
enum HolderType {
  INDIVIDUAL
  COMPANY
}

/// Role inside one organization. Five values now, granular permissions later:
/// call sites resolve capabilities through
/// `src/server/auth/capabilities.ts` rather than comparing this value, so
/// replacing the enum with a role/permission table stays a local change.
enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

/// The link that replaces `Profile.organizationId`, and the authority for
/// every landlord authorization decision.
///
/// One membership per (organization, person) — enforced by the composite
/// primary key, so a duplicate is impossible rather than merely unlikely.
///
/// NOT enforced in the database: "an organization always has at least one
/// ACTIVE OWNER". A CHECK cannot see other rows, and multiple OWNERs must
/// stay legal (an agency with two partners is the normal case), so a unique
/// index would be wrong. Enforced in
/// `src/server/domains/organizations/membership.ts`, with a test.
model OrganizationMember {
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profileId      String       @map("profile_id") @db.Uuid
  profile        Profile      @relation("MemberProfile", fields: [profileId], references: [id], onDelete: Cascade)

  orgRole OrgRole          @map("org_role")
  status  MembershipStatus @default(ACTIVE)

  joinedAt           DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  invitedByProfileId String?  @map("invited_by_profile_id") @db.Uuid
  invitedBy          Profile? @relation("MemberInvitedBy", fields: [invitedByProfileId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organizationId, profileId])
  @@index([profileId])
  @@index([organizationId, status])
  @@map("organization_members")
}

// ---------------------------------------------------------------------------
// Organizations & Spaces
// ---------------------------------------------------------------------------
enum OrganizationStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

model Organization {
  id                      String             @id @default(uuid()) @db.Uuid
  name                    String
  /// INDIVIDUAL or COMPANY. Drives which registration fields apply and
  /// whether a SIRET is required — see the CHECK constraints in migration
  /// 20260904100000_account_model_expand.
  holderType              HolderType         @default(COMPANY) @map("holder_type")
  /// Nullable since Phase 2: an individual holder has no SIRET. Still unique
  /// where present — PostgreSQL treats NULLs as distinct, so any number of
  /// individuals coexist while two companies cannot share a SIRET.
  siret                   String?            @unique
  /// Registration details, COMPANY only. Collected progressively: the
  /// verification of these values (Kbis, VAT lookup) is Phase 3.
  legalName               String?            @map("legal_name")
  siren                   String?
  vatNumber               String?            @map("vat_number")
  legalRepresentativeName String?            @map("legal_representative_name")
  status                  OrganizationStatus @default(PENDING_VERIFICATION)
  email                   String
  address                 String
  city                    String
  postalCode              String             @map("postal_code")
  // Stripe Connect account id (Express/Standard). Null until the
  // organization completes onboarding — payouts stay on the mock provider
  // until this is set and PAYMENT_PROVIDER=stripe.
  stripeAccountId         String?            @map("stripe_account_id")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// @deprecated the reverse side of `Profile.organizationId`. Use
  /// `memberships` — it is the authority for who belongs to an organization.
  members           Profile[]
  activeForProfiles Profile[]              @relation("ActiveOrganization")
  memberships       OrganizationMember[]
  verifications     LandlordVerification[]
  spaces            Space[]
  bookings          Booking[]
  payments          Payment[]
  auditLogs         AuditLog[]

  propertyOwnerOf    PropertyOwner[]
  propertyOperatorOf PropertyOperator[]
  propertyManagerOf  PropertyManager[]

  @@index([status])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Properties — the physical building. A Property holds one or more Spaces;
// who may let a Space on the platform is a question about the Property
// (its owner, operator, manager), not about the Space itself. See Phase 4.
// ---------------------------------------------------------------------------

/// Open on purpose: a physical building can be many things, and the product
/// will want more of them (retail, industrial…) without a schema migration
/// blocking every one. OTHER exists so a listing is never blocked on this
/// enum lagging the catalogue.
enum PropertyType {
  OFFICE
  COMMERCIAL
  COWORKING
  MEETING_SPACE
  RESIDENTIAL
  MIXED_USE
  OTHER
}

enum PropertyStatus {
  ACTIVE
  ARCHIVED
}

model Property {
  id           String         @id @default(uuid()) @db.Uuid
  label        String
  propertyType PropertyType   @map("property_type")
  status       PropertyStatus @default(ACTIVE)

  /// Free text, saveable as a draft and editable — not yet shown anywhere
  /// public (no Listing exists yet to display it on). Validated server-side
  /// (length) like every other field, nothing more: Phase 6 owns anything
  /// publication-shaped (SEO, a commercial title, visibility).
  description String?

  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  postalCode   String  @map("postal_code")
  city         String
  /// State/region, where the country has one. Free text: the shape differs
  /// per country and this is not yet validated against anything.
  region       String?
  /// ISO 3166-1 alpha-2. Defaults to "FR" because every property today is
  /// French; kept a plain column, not an enum, so expansion needs no schema
  /// change.
  country      String  @default("FR")

  /// Nullable while the geocoding provider is not yet decided (Phase 4 scope
  /// explicitly excludes it) — a property can be created and let before its
  /// coordinates are known.
  latitude  Float?
  longitude Float?

  createdByProfileId String  @map("created_by_profile_id") @db.Uuid
  createdBy          Profile @relation("PropertyCreatedBy", fields: [createdByProfileId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owners    PropertyOwner[]
  operators PropertyOperator[]
  managers  PropertyManager[]
  spaces    Space[]
  photos    PropertyPhoto[]

  @@index([city])
  @@index([status])
  @@map("properties")
}

/// A photo of the building itself (facade, common areas, entrance) — as
/// opposed to `SpacePhoto`, a photo of one reservable unit inside it.
///
/// `storagePath` is server-generated (see `src/server/domains/media/
/// photo-storage.ts`), never derived from the uploaded filename. At most one
/// PRIMARY photo per property is a partial UNIQUE index
/// (`property_photos_one_primary_idx`, added by hand in the migration — the
/// same reason `property_operators_one_current_idx` is not in this schema).
model PropertyPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  storagePath String   @unique @map("storage_path")
  mimeType    String   @map("mime_type")
  /// Nullable: a row backfilled from a legacy URL (see the Phase 5
  /// migration) has no reliably known size.
  sizeBytes   Int?     @map("size_bytes")
  width       Int?
  height      Int?
  position    Int      @default(0)
  isPrimary   Boolean  @default(false) @map("is_primary")
  altText     String?  @map("alt_text")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([propertyId])
  @@map("property_photos")
}

/// Who possesses the building, legally. `profileId` for a natural person
/// recorded outright (a co-owner who is not necessarily a platform landlord
/// themselves), `organizationId` for the usual case of an organization that
/// also acts on the platform — never both, never neither: see
/// `property_owners_holder_check` in the migration. Multiple rows express
/// co-ownership; `ownershipShareBasisPoints` is an integer (10000 = 100%)
/// because a legal quote-part is never a float. The sum of active owners'
/// shares for one property is a cross-row invariant a CHECK cannot see —
/// enforced in `src/server/domains/properties/owners.ts`, with a test, the
/// same documented trade-off as the booking/payment invariants above.
model PropertyOwner {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  profileId      String?       @map("profile_id") @db.Uuid
  profile        Profile?      @relation("PropertyOwnerProfile", fields: [profileId], references: [id], onDelete: Restrict)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  ownershipShareBasisPoints Int       @default(10000) @map("ownership_share_basis_points")
  startsAt                  DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt                    DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([propertyId])
  @@index([profileId])
  @@index([organizationId])
  @@map("property_owners")
}

/// Who is authorized to let the property on OfficeFlex — the owner
/// themselves, or a third party operating under a mandate
/// (`mandateReference`, free text: no canonical registry to validate
/// against yet). This is the relation later payout logic reads to know who
/// gets paid — see the same "not yet" note on PropertyManager below.
///
/// NOTE: at most one CURRENT operator (`endsAt IS NULL`) per property is
/// enforced by a partial UNIQUE index added by hand in the migration —
/// Prisma has no syntax for a partial index, so it does not appear here;
/// see `property_operators_one_current_idx`, the same pattern as the
/// booking EXCLUDE constraint documented above `model Booking`.
model PropertyOperator {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  profileId      String?       @map("profile_id") @db.Uuid
  profile        Profile?      @relation("PropertyOperatorProfile", fields: [profileId], references: [id], onDelete: Restrict)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  mandateReference String?   @map("mandate_reference")
  startsAt         DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([propertyId])
  @@index([organizationId])
  @@map("property_operators")
}

/// Runs the property day to day — calendar, requests, information — without
/// becoming an owner or an operator: a manager never automatically receives
/// revenue, and this phase does not yet grant one anything beyond being
/// recorded (no per-property RBAC yet; `scope` is free-form JSON reserved
/// for that). Both `profileId` and `organizationId` are nullable for the
/// same reason as PropertyOwner/PropertyOperator — see there.
model PropertyManager {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  profileId      String?       @map("profile_id") @db.Uuid
  profile        Profile?      @relation("PropertyManagerProfile", fields: [profileId], references: [id], onDelete: Restrict)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  /// Reserved for a future per-property permission model. Read nowhere yet
  /// — see the model doc comment.
  scope    Json?
  startsAt DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([propertyId])
  @@map("property_managers")
}

enum SpaceType {
  MEETING_ROOM
  DESK
  TRAINING_ROOM
}

enum SpaceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

/// A controlled vocabulary, not free text — so a future search filter can
/// query on it instead of matching strings someone typed. OTHER exists for
/// the case this list has not anticipated; extend the list itself, in a
/// migration, before reaching for OTHER as a permanent home for something
/// common.
enum SpaceAmenity {
  WIFI
  PARKING
  PROJECTOR
  SCREEN
  PRINTER
  KITCHEN
  AIR_CONDITIONING
  WHEELCHAIR_ACCESS
  COFFEE
  PHONE_BOOTH
  WHITEBOARD
  OTHER
}

model Space {
  id                 String         @id @default(uuid()) @db.Uuid
  propertyId         String         @map("property_id") @db.Uuid
  property           Property       @relation(fields: [propertyId], references: [id])
  /// @deprecated legacy direct link, kept live: every read and write in this
  /// phase still uses it for authorization (unchanged, see Phase 4 report),
  /// and it must always name an organization that is a CURRENT owner or
  /// operator of `property` — checked in the service layer
  /// (`src/server/domains/organizations/create-space.ts`,
  /// `update-space.ts`), not by a CHECK, for the same cross-table reason as
  /// the other invariants documented above. Superseding it with
  /// Property-derived authorization is Phase 5+ work.
  organizationId     String         @map("organization_id") @db.Uuid
  organization       Organization   @relation(fields: [organizationId], references: [id])
  slug               String         @unique
  name               String
  type               SpaceType
  description        String
  address            String
  city               String
  postalCode         String         @map("postal_code")
  capacity           Int
  amenities          SpaceAmenity[]
  /// @deprecated legacy free-text amenity values, from before this column
  /// was a controlled enum array (Phase 5). Preserved for anything not
  /// mappable onto `SpaceAmenity` — see the migration backfill. Nothing
  /// writes to it any more.
  amenitiesLegacy    String[]       @default([]) @map("amenities_legacy")
  /// @deprecated superseded by `SpacePhoto` (Phase 5), which is what new
  /// uploads write to. Kept and still read by the public space page and
  /// search card, which are not yet wired to the new model — see the
  /// Phase 5 report, DETTE TECHNIQUE. Not written to any more.
  photos             String[]
  halfDayPriceCents  Int            @map("half_day_price_cents")
  dayPriceCents      Int            @map("day_price_cents")
  /// Percentage off both half-day and day price, applied server-side in
  /// computeDaySlots() — never sent by the client. Null means no discount.
  /// Bounded 0-100 by a CHECK, not just Zod: the same reason every other
  /// money-adjacent column here has one (officeflex-security-guardrails §5).
  discountPercent    Int?           @map("discount_percent")
  // Shown to the client only after a booking is confirmed (door code,
  // reception instructions, floor). Optional: partners may not need one.
  accessInstructions String?        @map("access_instructions")
  // IANA zone the opening hours are expressed in — see domains/bookings/timezone.ts.
  timezone           String         @default("Europe/Paris")
  status             SpaceStatus    @default(DRAFT)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  openingHours SpaceOpeningHours[]
  closures     SpaceClosure[]
  bookings     Booking[]
  favorites    Favorite[]
  spacePhotos  SpacePhoto[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([propertyId])
  @@index([city, status])
  @@map("spaces")
}

/// A photo of a `Space` — as opposed to `PropertyPhoto`, a photo of the
/// building. Same shape and the same partial-unique-index primary-photo
/// guarantee (`space_photos_one_primary_idx`) as `PropertyPhoto` — see its
/// doc comment for what is deliberately not here (a DB size-positive CHECK,
/// width/height population).
model SpacePhoto {
  id          String   @id @default(uuid()) @db.Uuid
  spaceId     String   @map("space_id") @db.Uuid
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  storagePath String   @unique @map("storage_path")
  mimeType    String   @map("mime_type")
  sizeBytes   Int?     @map("size_bytes")
  width       Int?
  height      Int?
  position    Int      @default(0)
  isPrimary   Boolean  @default(false) @map("is_primary")
  altText     String?  @map("alt_text")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([spaceId])
  @@map("space_photos")
}

/// Multiple slots per weekday are supported since Phase 5 — no longer one
/// `[spaceId, weekday]` unique row per day (dropped in the Phase 5
/// migration). Overlap between two slots on the same weekday cannot be a
/// CHECK (cross-row); validated in
/// `src/lib/validation/spaces.ts#openingHoursWeekSchema` and
/// `src/server/domains/organizations/opening-hours.ts`, with a test.
model SpaceOpeningHours {
  id       String @id @default(uuid()) @db.Uuid
  spaceId  String @map("space_id") @db.Uuid
  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  weekday  Int // 0 = Sunday .. 6 = Saturday
  opensAt  String @map("opens_at") // "09:00"
  closesAt String @map("closes_at") // "19:00"

  @@index([spaceId, weekday])
  @@map("space_opening_hours")
}

model SpaceClosure {
  id       String   @id @default(uuid()) @db.Uuid
  spaceId  String   @map("space_id") @db.Uuid
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  reason   String

  @@index([spaceId])
  @@map("space_closures")
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  COMPLETED
}

// NOTE: double-booking is prevented at the database level by a PostgreSQL
// EXCLUDE constraint on (space_id, tsrange(starts_at, ends_at)) for rows
// where status is PENDING or CONFIRMED. Added by hand in migration 0003
// (Prisma cannot express EXCLUDE constraints) — see prisma/migrations.
model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  spaceId               String        @map("space_id") @db.Uuid
  space                 Space         @relation(fields: [spaceId], references: [id])
  organizationId        String        @map("organization_id") @db.Uuid
  organization          Organization  @relation(fields: [organizationId], references: [id])
  clientUserId          String        @map("client_user_id") @db.Uuid
  clientUser            Profile       @relation(fields: [clientUserId], references: [id])
  startsAt              DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime      @map("ends_at") @db.Timestamptz(3)
  status                BookingStatus @default(PENDING)
  participantsCount     Int           @map("participants_count")
  purpose               String
  priceAmountCents      Int           @map("price_amount_cents")
  commissionAmountCents Int           @map("commission_amount_cents")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment      Payment?
  disputes     Dispute[]
  conversation Conversation?

  // Referenced side of the composite foreign keys that keep the
  // denormalised organizationId in step with the space's and the
  // payment's — see migration 20260903110100_business_integrity_constraints.
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([spaceId, startsAt])
  @@index([clientUserId])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------
enum PaymentStatus {
  REQUIRES_CAPTURE
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  bookingId               String        @unique @map("booking_id") @db.Uuid
  booking                 Booking       @relation(fields: [bookingId], references: [id])
  organizationId          String        @map("organization_id") @db.Uuid
  organization            Organization  @relation(fields: [organizationId], references: [id])
  provider                String        @default("mock")
  providerPaymentIntentId String        @unique @map("provider_payment_intent_id")
  amountCents             Int           @map("amount_cents")
  commissionAmountCents   Int           @map("commission_amount_cents")
  netAmountCents          Int           @map("net_amount_cents")
  status                  PaymentStatus @default(REQUIRES_CAPTURE)
  capturedAt              DateTime?     @map("captured_at") @db.Timestamptz(3)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  refunds Refund[]

  @@index([organizationId, status])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  payment          Payment      @relation(fields: [paymentId], references: [id])
  amountCents      Int          @map("amount_cents")
  reason           String
  providerRefundId String       @unique @map("provider_refund_id")
  status           RefundStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([paymentId])
  @@map("refunds")
}

// Idempotency ledger for provider webhooks (Stripe today, others later).
model WebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String   @unique @map("provider_event_id")
  type            String
  payload         Json
  processedAt     DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@index([provider, type])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------
enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED_REFUND
  RESOLVED_NO_ACTION
  ESCALATED
}

model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  booking         Booking       @relation(fields: [bookingId], references: [id])
  raisedByUserId  String        @map("raised_by_user_id") @db.Uuid
  raisedBy        Profile       @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id])
  status          DisputeStatus @default(OPEN)
  description     String
  resolutionNotes String?       @map("resolution_notes")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  events DisputeEvent[]

  @@index([bookingId])
  @@index([status])
  @@map("disputes")
}

// Append-only trail of status changes, for the traced/timestamped process
// required by the brief (signalement -> enquête -> résolution).
model DisputeEvent {
  id        String        @id @default(uuid()) @db.Uuid
  disputeId String        @map("dispute_id") @db.Uuid
  dispute   Dispute       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  status    DisputeStatus
  note      String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([disputeId])
  @@map("dispute_events")
}

// ---------------------------------------------------------------------------
// Messaging — one conversation per booking. Participants are implicit: the
// booking's client, and any ACTIVE member of the organization that owns the
// booking's space — never stored as a participant list, so a membership
// change (someone joining or leaving the organization) is reflected without
// a migration of its own. See src/server/domains/messaging/.
// ---------------------------------------------------------------------------
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String       @map("sender_user_id") @db.Uuid
  sender         Profile      @relation(fields: [senderUserId], references: [id])
  body           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Support — "Nous contacter". Reachable without an account: a visitor
// blocked before signing up still needs a way to reach the team, so
// `userId` is nullable and `email` is collected directly rather than
// derived from a session that may not exist.
// ---------------------------------------------------------------------------
enum SupportTicketStatus {
  OPEN
  CLOSED
}

model SupportTicket {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  user      Profile?            @relation(fields: [userId], references: [id])
  email     String
  subject   String
  message   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("support_tickets")
}

// ---------------------------------------------------------------------------
// Misc
// ---------------------------------------------------------------------------
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  user      Profile  @relation(fields: [userId], references: [id])
  spaceId   String   @map("space_id") @db.Uuid
  space     Space    @relation(fields: [spaceId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, spaceId])
  @@map("favorites")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  actor          Profile?      @relation(fields: [actorUserId], references: [id])
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  event          String
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([event])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Analytics — KPI instrumentation (cahier des charges §13). Deliberately
// anonymous: `/search` requires no account ("recherche rapide, sans
// inscription requise"), so there is no user to attach this to without
// inventing a session identity purely to track it. No IP, no user agent —
// data-minimization (saas-engineering:product-analytics §6): resultsCount
// and the two filters actually used are the only properties a conversion-
// rate question needs.
// ---------------------------------------------------------------------------
model SearchEvent {
  id           String   @id @default(uuid()) @db.Uuid
  city         String?
  hasGeo       Boolean  @default(false) @map("has_geo")
  resultsCount Int      @map("results_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("search_events")
}
