# Copy this file to .env and fill in your own values. Never commit .env.

# --- Supabase ---------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
# Project Settings → API → service_role key.
# SERVER-ONLY. Never prefix this NEXT_PUBLIC_, never import it from a
# Client Component or send it to the browser — it bypasses Auth entirely.
SUPABASE_SERVICE_ROLE_KEY="ey..."

# --- Database (Postgres, provided by Supabase) -------------------------
# Project Settings → Database → Connection string.
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — used by the app.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: direct connection (port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Payments (Stripe) ---------------------------------------------------
# "mock" until Stripe Connect keys exist — see src/server/domains/payments.
# Switching to "stripe" is global — every booking on the platform goes
# through real Stripe, there is no per-organization toggle.
PAYMENT_PROVIDER="mock"
PAYMENT_MOCK_WEBHOOK_SECRET="mock-secret"
# Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=""
# Dashboard → Developers → Webhooks → your endpoint (/api/webhooks/stripe)
# → Signing secret. The endpoint must be registered manually in the Stripe
# dashboard; nothing in this app does that for you.
STRIPE_WEBHOOK_SECRET=""
# Dashboard → Developers → API keys → Publishable key. Safe to expose — read
# by the browser to mount the card step (src/components/booking/stripe-card-step.tsx).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Transactional email (Resend) -----------------------------------------
# "log" until a real provider is configured — see src/server/domains/notifications.
EMAIL_PROVIDER="log"
# resend.com → API Keys.
RESEND_API_KEY=""
# Must be on a domain verified in Resend, or sending fails at request time.
# Resend's own onboarding@resend.dev works with zero setup, but only for
# emails addressed to the Resend account's own verified address(es).
EMAIL_FROM="OfficeFlex <onboarding@resend.dev>"

# --- Seed (local development only) --------------------------------------
# `pnpm db:seed` creates an ADMIN account with the service role key. It
# refuses to run unless DATABASE_URL points at localhost.
# Leave the passwords unset to have one generated and printed per run; set
# them (12+ characters) if you want stable local credentials.
# SEED_ADMIN_EMAIL="admin@officeflex.demo"
# SEED_ADMIN_PASSWORD=""
# SEED_PARTNER_PARIS_PASSWORD=""
# SEED_PARTNER_LYON_PASSWORD=""
# SEED_CLIENT_PASSWORD=""

# --- Rate limiting -------------------------------------------------------
# The default in-memory store counts per process. On Vercel that means per
# instance, reset on every cold start — so it is NOT an effective control in
# production, only in development and tests.
#
# Leave RATE_LIMIT_STORE unset to auto-select: Upstash when the two variables
# below are present, memory otherwise. Set it explicitly to force one.
# RATE_LIMIT_STORE="upstash"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
#
# Salt for the hashed account component of a rate-limit key, so no email ever
# reaches the rate-limit store. Any long random string; changing it just
# resets the per-account counters.
# RATE_LIMIT_KEY_SALT=""
#
# Set to "true" to run in production with the in-memory store anyway. Without
# it, that combination is logged as an error on every cold start.
# RATE_LIMIT_ALLOW_INSECURE_MEMORY_STORE="false"

# --- Runtime mode --------------------------------------------------------
# Declares a deployment as a demo, so the app serves everyone as signed out
# instead of reporting missing Supabase/database configuration as an error.
# Required on a zero-config production deploy; leave unset otherwise.
# OFFICEFLEX_DEMO_MODE="false"

# --- Misc ---------------------------------------------------------------
LOG_LEVEL="info"
