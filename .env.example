# Copy this file to .env and fill in your own values. Never commit .env.

# --- Public URL ------------------------------------------------------------
# The URL visitors use, e.g. https://makomspace.fr. Used to accept
# state-changing API requests from our own pages only (CSRF guard, see
# src/server/lib/request-origin.ts) — required in production behind a
# reverse proxy, where the app may see an internal host.
APP_URL="http://localhost:3000"

# --- Supabase ---------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
# Project Settings → API → service_role key.
# SERVER-ONLY. Never prefix this NEXT_PUBLIC_, never import it from a
# Client Component or send it to the browser — it bypasses Auth entirely.
SUPABASE_SERVICE_ROLE_KEY="ey..."

# --- Database (Postgres, provided by Supabase) -------------------------
# Project Settings → Database → Connection string.
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — used by the app.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: direct connection (port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Payments (Stripe) ---------------------------------------------------
# "mock" until Stripe Connect keys exist — see src/server/domains/payments.
# Switching to "stripe" is global — every booking on the platform goes
# through real Stripe, there is no per-organization toggle.
#
# PRODUCTION (NODE_ENV=production without OFFICEFLEX_DEMO_MODE=true):
#   - PAYMENT_PROVIDER has no default — it must be set, or booking and
#     payment routes answer 503 (see src/server/config/deployment-config.ts);
#   - "mock" (staging only) requires OFFICEFLEX_ALLOW_MOCK_PAYMENTS="true"
#     and PAYMENT_MOCK_WEBHOOK_SECRET of 32+ random characters, e.g.
#     `openssl rand -hex 32`. Never on the real platform: mock payments
#     confirm bookings without charging anyone.
# Locally, leaving the secret unset uses the development default "mock-secret".
PAYMENT_PROVIDER="mock"
PAYMENT_MOCK_WEBHOOK_SECRET=""
# Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=""
# Dashboard → Developers → Webhooks → your endpoint (/api/webhooks/stripe)
# → Signing secret. The endpoint must be registered manually in the Stripe
# dashboard; nothing in this app does that for you. Subscribe it to:
#   payment_intent.amount_capturable_updated  (card authorized -> request sent)
#   payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled
#   refund.created, refund.updated
#   charge.dispute.created, charge.dispute.updated, charge.dispute.closed
#   account.updated (Connect: journals each landlord account's state in the
#     audit log — Stripe sends it to an endpoint listening to connected
#     accounts, which has its own signing secret; until a second secret is
#     supported, register it on the same endpoint only if Stripe lets you)
# Landlords must finish Stripe Connect onboarding (charges and payouts
# enabled) before their spaces can be booked; the commission (15 %) is taken
# as the application fee of each destination charge.
STRIPE_WEBHOOK_SECRET=""
# Dashboard → Developers → API keys → Publishable key. Safe to expose — read
# by the browser to mount the card step (src/components/booking/stripe-card-step.tsx).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Transactional email (Resend) -----------------------------------------
# "log" until a real provider is configured — see src/server/domains/notifications.
EMAIL_PROVIDER="log"
# resend.com → API Keys.
RESEND_API_KEY=""
# Must be on a domain verified in Resend, or sending fails at request time.
# Resend's own onboarding@resend.dev works with zero setup, but only for
# emails addressed to the Resend account's own verified address(es).
EMAIL_FROM="MakomSpace <onboarding@resend.dev>"
# Platform operators alerted by e-mail on a new booking dispute and on a
# Stripe chargeback. One address or a comma-separated list. Empty = no alert
# (the back office still lists everything).
ADMIN_ALERT_EMAIL=""

# --- Scheduled jobs ----------------------------------------------------------
# Bearer token for /api/internal/* (expire stale booking requests). Without
# it the route refuses every call. Use a different value per environment:
# `openssl rand -hex 32`.
CRON_SECRET=""

# --- Seed (local development only) --------------------------------------
# `pnpm db:seed` creates an ADMIN account with the service role key. It
# refuses to run unless DATABASE_URL points at localhost.
# Leave the passwords unset to have one generated and printed per run; set
# them (12+ characters) if you want stable local credentials.
# SEED_ADMIN_EMAIL="admin@officeflex.demo"
# SEED_ADMIN_PASSWORD=""
# SEED_PARTNER_PARIS_PASSWORD=""
# SEED_PARTNER_LYON_PASSWORD=""
# SEED_CLIENT_PASSWORD=""

# --- Rate limiting -------------------------------------------------------
# The default in-memory store counts per process. On Vercel that means per
# instance, reset on every cold start — so it is NOT an effective control in
# production, only in development and tests.
#
# Leave RATE_LIMIT_STORE unset to auto-select: Upstash when the two variables
# below are present, memory otherwise. Set it explicitly to force one.
# RATE_LIMIT_STORE="upstash"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
#
# The one header your edge sets with the real client IP and that a client
# cannot forge. Only this header is trusted for per-IP limits; all others
# are ignored. Behind a Cloudflare tunnel: cf-connecting-ip (and make sure
# Traefik is reachable only through cloudflared). Leave unset on Vercel.
# TRUSTED_CLIENT_IP_HEADER="cf-connecting-ip"
#
# Salt for the hashed account component of a rate-limit key, so no email ever
# reaches the rate-limit store. Any long random string; changing it just
# resets the per-account counters.
# RATE_LIMIT_KEY_SALT=""
#
# Set to "true" to run in production with the in-memory store anyway. Without
# it, that combination is logged as an error on every cold start.
# RATE_LIMIT_ALLOW_INSECURE_MEMORY_STORE="false"

# --- Runtime mode --------------------------------------------------------
# Declares a deployment as a demo, so the app serves everyone as signed out
# instead of reporting missing Supabase/database configuration as an error.
# Required on a zero-config production deploy; leave unset otherwise.
# OFFICEFLEX_DEMO_MODE="false"

# --- Misc ---------------------------------------------------------------
LOG_LEVEL="info"

# --- Error tracking (GlitchTip, through the Sentry SDK) ---------------------
# No DSN = no error reporting at all (demo-mode contract). Server and
# browser DSNs are usually the same GlitchTip project DSN. NEXT_PUBLIC_* are
# baked in at build time (one image per environment).
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# Tracing is off by default (GlitchTip handles errors, not performance).
# SENTRY_TRACES_SAMPLE_RATE="0"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
# Source map upload at build time (CI only; the token is a build secret):
# SENTRY_URL="https://glitchtip.example.fr/"  SENTRY_ORG=""  SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# --- Analytics -------------------------------------------------------------
# Umami (self-hosted, cookieless): loaded when both are set, no consent needed.
# NEXT_PUBLIC_UMAMI_SRC="https://umami.example.fr/script.js"
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
# PostHog: loaded ONLY after the visitor accepts in the consent banner.
# Use the EU region host.
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# --- Content-Security-Policy ------------------------------------------------
# Sent as Content-Security-Policy-Report-Only until this is "true". Switch it
# on once staging shows no violation (src/server/config/csp.ts).
# CSP_ENFORCE="false"

# --- Invoicing (assumptions to validate with the accountant) -----------------
# See src/server/domains/invoicing/config.ts.
# RENTAL_VAT_RATE="20"            # bookings, when the landlord has a VAT number
# COMMISSION_VAT_RATE="20"        # platform commission (VAT-inclusive)
# INVOICE_NUMBER_PREFIX="F"       # F-<org code>-<year>-<n>, one series per landlord
# COMMISSION_INVOICE_NUMBER_PREFIX="FC"
# STRIPE_COMMISSION_TAX_RATE_ID="" # optional: reuse an existing inclusive Stripe tax rate
# The platform's own identity, printed on every invoice ("[à compléter]" until set):
# PLATFORM_LEGAL_NAME=""  PLATFORM_LEGAL_FORM=""  PLATFORM_SHARE_CAPITAL=""
# PLATFORM_ADDRESS=""  PLATFORM_SIRET=""  PLATFORM_RCS=""  PLATFORM_VAT_NUMBER=""
# PLATFORM_BILLING_EMAIL=""

# --- Build metadata ----------------------------------------------------------
# Set by the image build (Dockerfile ARG APP_VERSION); shown in logs and errors.
# APP_VERSION="dev"
